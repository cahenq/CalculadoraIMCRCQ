</style>
<style name="Field"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">8dp</item><item name="android:padding">12dp</item><item name="android:textSize">16sp</item><item name="android:background">@drawable/field_bg</item></style>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_nutrilife">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="♥  NutriLife" android:textColor="#FF777D" android:textStyle="bold" android:textSize="27sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:text="Resultado" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="26sp"/>
    <TextView android:id="@+id/txtSaudacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="ÍNDICE DE MASSA CORPORAL" android:textColor="#CFFFFA" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/txtImc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp"/>
    <TextView android:id="@+id/txtClassificacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="16sp"/>
    <TextView android:id="@+id/txtRiscoImc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#E5FFFC" android:textSize="14sp" android:lineSpacingExtra="2dp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#55FFFFFF"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="RELAÇÃO CINTURA-QUADRIL" android:textColor="#CFFFFA" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/txtRcq" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp"/>
    <TextView android:id="@+id/txtRiscoRcq" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="16sp"/>
    <Button android:id="@+id/btnCompartilhar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp" android:background="@drawable/button_pdf" android:text="COMPARTILHAR" android:textColor="#FFFFFF" android:textStyle="bold" android:letterSpacing="0.08"/>
    <Button android:id="@+id/btnVoltar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/field_pdf" android:text="VOLTAR" android:textColor="#086A67" android:textStyle="bold"/>
</LinearLayout></ScrollView>
